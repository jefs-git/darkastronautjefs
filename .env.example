# Modelo das variaveis de ambiente. Copie para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" com credenciais (ele esta no .gitignore).

AZURE_SQL_SERVER=seu-servidor.database.windows.net
AZURE_SQL_DATABASE=seu-banco
AZURE_SQL_USER=seu-usuario
AZURE_SQL_PASSWORD=sua-senha

# Driver ODBC: local (Windows) use 17; Azure App Service (Linux) use 18.
AZURE_SQL_DRIVER=ODBC Driver 17 for SQL Server
